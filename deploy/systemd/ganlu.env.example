# Install as /etc/ganlu/ganlu.env with owner root:ganlu and mode 0640.
# Replace all values at deployment time. This file contains placeholders only.
JAVA_OPTS=-Xms256m -Xmx768m -Djava.io.tmpdir=/var/tmp/ganlu-multipart
SERVER_PORT=8080
GANLU_SERVER_ADDRESS=127.0.0.1
GANLU_DB_URL=jdbc:mysql://127.0.0.1:3306/ganlu?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
GANLU_DB_USERNAME=REPLACE_WITH_LEAST_PRIVILEGE_DB_USER
GANLU_DB_PASSWORD=REPLACE_AT_DEPLOYMENT
GANLU_JWT_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_BYTE_SECRET
GANLU_ALLOWED_ORIGINS=https://REPLACE_WITH_PUBLIC_HOST
GANLU_APP_BASE_URL=https://REPLACE_WITH_PUBLIC_HOST
UPLOAD_DIR=/srv/ganlu/uploads
GANLU_MULTIPART_TEMP_DIR=/var/tmp/ganlu-multipart
AUDIT_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
AUDIT_RETENTION_DAYS=180
GANLU_SCHEMA_VALIDATION_ENABLED=true
