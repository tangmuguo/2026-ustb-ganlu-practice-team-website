# 仅作环境变量索引；实际安全默认值见同目录 application.properties。
spring.profiles.active=${SPRING_PROFILES_ACTIVE:dev}
security.jwt.expiration-seconds=${GANLU_JWT_EXPIRATION_SECONDS:28800}

# 团队视频/附件最大 200MB；公共图片仍由业务层限制为 5MB。
spring.servlet.multipart.max-file-size=${GANLU_MAX_UPLOAD_FILE_SIZE:200MB}
spring.servlet.multipart.max-request-size=${GANLU_MAX_UPLOAD_REQUEST_SIZE:210MB}
spring.servlet.multipart.file-size-threshold=${GANLU_UPLOAD_MEMORY_THRESHOLD:10MB}
spring.servlet.multipart.location=${GANLU_MULTIPART_TEMP_DIR:${java.io.tmpdir}/ganlu-multipart}

team.public-image.user-permanent-quota-mb=${TEAM_PUBLIC_IMAGE_USER_PERMANENT_QUOTA_MB:500}
team.public-image.max-permanent-files-per-user=${TEAM_PUBLIC_IMAGE_MAX_PERMANENT_FILES:100}
team.public-image.min-free-disk-mb=${TEAM_PUBLIC_IMAGE_MIN_FREE_DISK_MB:1024}

team.media.owner-max-files=${TEAM_MEDIA_OWNER_MAX_FILES:50}
team.media.owner-max-total-mb=${TEAM_MEDIA_OWNER_MAX_TOTAL_MB:2048}
team.media.global-max-files=${TEAM_MEDIA_GLOBAL_MAX_FILES:2000}
team.media.global-max-total-mb=${TEAM_MEDIA_GLOBAL_MAX_TOTAL_MB:20480}
team.media.upload-min-free-disk-mb=${TEAM_MEDIA_UPLOAD_MIN_FREE_DISK_MB:1024}
team.media.multipart-min-free-disk-mb=${TEAM_MEDIA_MULTIPART_MIN_FREE_DISK_MB:1024}
team.media.archived-retention-days=${TEAM_MEDIA_ARCHIVED_RETENTION_DAYS:30}
team.media.max-concurrent-uploads=${TEAM_MEDIA_MAX_CONCURRENT_UPLOADS:4}
team.media.max-requests-per-user-per-minute=${TEAM_MEDIA_MAX_REQUESTS_PER_USER_PER_MINUTE:12}
team.media.upload-reservation-ttl-minutes=${TEAM_MEDIA_UPLOAD_RESERVATION_TTL_MINUTES:120}
team.public-image.migration-enabled=${TEAM_PUBLIC_IMAGE_MIGRATION_ENABLED:false}
file-deletion.retry-interval-ms=${FILE_DELETION_RETRY_INTERVAL_MS:60000}

ai.enabled=${AI_ENABLED:false}
ai.base-url=${DEEPSEEK_BASE_URL:https://api.deepseek.com}
ai.api-key=${DEEPSEEK_API_KEY:}
ai.model=${DEEPSEEK_MODEL:deepseek-v4-flash}

ganlu.bootstrap-admin.username=${GANLU_BOOTSTRAP_ADMIN_USERNAME:}
ganlu.bootstrap-admin.password=${GANLU_BOOTSTRAP_ADMIN_PASSWORD:}
ganlu.bootstrap-admin.phone=${GANLU_BOOTSTRAP_ADMIN_PHONE:}
