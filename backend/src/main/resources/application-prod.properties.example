# 生产环境不提供任何数据库密码、跨域来源或 JWT 密钥的默认值。
server.port=${SERVER_PORT:8080}
spring.datasource.url=${GANLU_DB_URL}
spring.datasource.username=${GANLU_DB_USERNAME}
spring.datasource.password=${GANLU_DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

file.upload-dir=${UPLOAD_DIR:/usr/share/ganlu/uploads}
app.allowed-origins=${GANLU_ALLOWED_ORIGINS}
app.base-url=${GANLU_APP_BASE_URL}
security.jwt.secret=${GANLU_JWT_SECRET}
