<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.vihu.ganlu.mappers.TeamPageMapper">
    <resultMap type="com.vihu.ganlu.entitys.TeamPageEntity" id="teamPageMap">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="team_id" property="teamId"/>
        <result column="status_code" property="status"/>
    </resultMap>

    <sql id="teamPageColumns">
        id, title, content, created_at, updated_at, team_id,
        CASE status
            WHEN '草稿' THEN 'DRAFT'
            WHEN '展示' THEN 'PUBLISHED'
            WHEN '归档' THEN 'ARCHIVED'
        END AS status_code
    </sql>

    <select id="findById" resultMap="teamPageMap">
        SELECT
        <include refid="teamPageColumns"/>
        FROM team_page
        WHERE id = #{id}
    </select>

    <select id="findByTeamId" resultMap="teamPageMap">
        SELECT
        <include refid="teamPageColumns"/>
        FROM team_page
        WHERE team_id = #{teamId}
    </select>

    <insert id="insertTeamPage" parameterType="com.vihu.ganlu.entitys.TeamPageEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO team_page (
            title, content, created_at, updated_at, team_id, status
        ) VALUES (
            #{title}, #{content}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, #{teamId},
            #{status.databaseValue}
        )
    </insert>

    <update id="updateMetadataByTeamId" parameterType="com.vihu.ganlu.entitys.TeamPageEntity">
        UPDATE team_page
        SET title = #{title},
            status = #{status.databaseValue},
            updated_at = CURRENT_TIMESTAMP
        WHERE team_id = #{teamId}
    </update>
</mapper>
