<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.vihu.ganlu.mappers.TeamPageWordMapper">
    <resultMap type="com.vihu.ganlu.entitys.TeamPageWordEntity" id="teampagewordmap">
        <id column="id" property="id"/>
        <result column="team_id" property="teamId"/>
        <result column="status" property="status"/>
        <result column="reject_reason" property="rejectReason"/>
        <result column="log_date" property="logDate"/>
        <result column="userId" property="userId"/>
        <result column="pageId" property="pageId"/>
        <result column="videoUrl" property="videoUrl"/>
        <result column="thumbnailUrl" property="thumbnailUrl"/>
        <result column="caption" property="caption"/>
        <result column="content" property="content"/>
        <result column="duration" property="duration"/>
        <result column="displayOrder" property="displayOrder"/>
        <result column="createdAt" property="createdAt"/>
        <result column="updatedAt" property="updatedAt"/>
        <result column="type" property="type"/>
    </resultMap>

    <select id="findAllWord" parameterType="Integer" resultMap="teampagewordmap">
        select * from team_page_word where userId=#{userId}
    </select>

    <select id="findByTeamId" parameterType="Integer" resultMap="teampagewordmap">
        select * from team_page_word
        where team_id = #{teamId} and status &lt;&gt; 'ARCHIVED'
    </select>

    <select id="findByTeamIdAndStatus" resultMap="teampagewordmap">
        select * from team_page_word
        where team_id = #{teamId}
        <if test="status != null and status != ''">
            and status = #{status}
        </if>
    </select>

    <select id="findById" parameterType="Integer" resultMap="teampagewordmap">
        select * from team_page_word where id = #{id}
    </select>

    <select id="findByIdForUpdate" parameterType="Integer" resultMap="teampagewordmap">
        select * from team_page_word where id = #{id} for update
    </select>

    <insert id="insertTeamWord" parameterType="com.vihu.ganlu.entitys.TeamPageWordEntity"
            useGeneratedKeys="true" keyProperty="id">
        insert into team_page_word(
            team_id, status, reject_reason, log_date,
            userId, caption, content, createdAt, type
        )VALUES (
            #{teamId}, #{status}, #{rejectReason}, #{logDate},
            #{userId}, #{caption}, #{content}, NOW(), #{type}
        )
    </insert>

    <update id="updateWordStatus">
        update team_page_word
        set status = #{status},
            reject_reason = #{rejectReason},
            updatedAt = NOW()
        where id = #{id}
    </update>

    <update id="archiveById">
        update team_page_word
        set status = 'ARCHIVED', updatedAt = NOW()
        where id = #{id}
    </update>

    <update id="archiveByIdAndTeamId">
        update team_page_word
        set status = 'ARCHIVED', updatedAt = NOW()
        where id = #{id} and team_id = #{teamId}
    </update>

    <delete id="deleteTeamPageWordByIds" parameterType="com.vihu.ganlu.entitys.UserQueryVo">
        delete from team_page_word
        <where>
            id in
            <foreach collection="ids" item="id" separator="," open="(" close=")">
                #{id}
            </foreach>
        </where>
    </delete>

    <delete id="deleteTeamPageWordByIdsAndUserId">
        delete from team_page_word
        where userId = #{userId}
          and id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="purgeById">
        delete from team_page_word where id = #{id}
    </delete>
</mapper>
