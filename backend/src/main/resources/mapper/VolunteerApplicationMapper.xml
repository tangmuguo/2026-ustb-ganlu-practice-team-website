<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vihu.ganlu.mappers.VolunteerApplicationMapper">
    <resultMap id="volunteerApplicationMap" type="com.vihu.ganlu.entitys.VolunteerApplicationEntity">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="phone" property="phone"/>
        <result column="organization" property="organization"/>
        <result column="grade_or_major" property="gradeOrMajor"/>
        <result column="preferred_region" property="preferredRegion"/>
        <result column="skills" property="skills"/>
        <result column="introduction" property="introduction"/>
        <result column="privacy_agreed" property="privacyAgreed"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into volunteer_application
        (name, phone, organization, grade_or_major, preferred_region, skills, introduction, privacy_agreed, status)
        values
        (#{name}, #{phone}, #{organization}, #{gradeOrMajor}, #{preferredRegion}, #{skills}, #{introduction}, #{privacyAgreed}, #{status})
    </insert>

    <select id="count" resultType="int">
        select count(1) from volunteer_application
        <where><if test="status != null and status != ''">status=#{status}</if></where>
    </select>

    <select id="findPage" resultMap="volunteerApplicationMap">
        select * from volunteer_application
        <where><if test="status != null and status != ''">status=#{status}</if></where>
        order by created_at desc, id desc
        limit #{offset}, #{pageSize}
    </select>

    <update id="updateStatus">
        update volunteer_application set status=#{status}, updated_at=current_timestamp where id=#{id}
    </update>
</mapper>
