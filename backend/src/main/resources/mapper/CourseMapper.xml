<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.vihu.ganlu.mappers.CourseMapper">
    <resultMap type="com.vihu.ganlu.entitys.CourseEntity" id="courseMap">
        <id column="id" property="id"/>
        <result column="course_name" property="courseName"/>
        <result column="status" property="status"/>
    </resultMap>

    <select id="getActiveCourses" resultMap="courseMap">
        SELECT id, course_name, status
        FROM course
        WHERE status = 1
        ORDER BY id ASC
    </select>

    <select id="getAllCourses" resultMap="courseMap">
        SELECT id, course_name, status
        FROM course
        ORDER BY status DESC, id ASC
    </select>

    <select id="getCourseById" parameterType="Integer" resultMap="courseMap">
        SELECT id, course_name, status
        FROM course
        WHERE id = #{id}
    </select>

    <select id="countActiveCourses" resultType="Integer">
        SELECT COUNT(*) FROM course WHERE status = 1
    </select>

    <select id="countByName" resultType="Integer">
        SELECT COUNT(*)
        FROM course
        WHERE course_name = #{courseName}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <insert id="insertCourse" parameterType="com.vihu.ganlu.entitys.CourseEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO course(course_name, status)
        VALUES(#{courseName}, #{status})
    </insert>

    <update id="updateCourse" parameterType="com.vihu.ganlu.entitys.CourseEntity">
        UPDATE course
        SET course_name = #{courseName}, status = #{status}
        WHERE id = #{id}
    </update>
</mapper>
