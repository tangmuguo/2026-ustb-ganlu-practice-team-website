# Merge these keys into the active application-<profile>.properties file.
# Keep machine-specific values in environment variables; do not commit real paths or secrets.

# Windows example: C:/Program Files/LibreOffice/program/soffice.exe
# Linux example: /usr/bin/soffice
material.libreoffice.executable=${LIBREOFFICE_EXECUTABLE:}
material.libreoffice.timeout-seconds=${LIBREOFFICE_TIMEOUT_SECONDS:90}

# Each HTTP request contains a 5 MB chunk. The assembled file limit is enforced at 200 MB.
spring.servlet.multipart.max-file-size=8MB
spring.servlet.multipart.max-request-size=8MB
